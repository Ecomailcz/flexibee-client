<?xml version="1.0"?>
<ruleset name="Ecomail - FlexiBee client">
	<!-- The package supports PHP 8.2+: never suggest syntax newer than the declared minimum. -->
	<config name="php_version" value="80200"/>

	<rule ref="vendor/pekral/phpcs-rules/ruleset.xml"/>

	<!-- Published API: renaming Config::verifySSLCertificate() would break consumers. -->
	<rule ref="Generic.NamingConventions.CamelCapsFunctionName.ScopeNotCamelCaps">
		<exclude-pattern>src/Config.php</exclude-pattern>
	</rule>

	<!-- Published API: Client is the package entry point; splitting it is a separate, BC-breaking change. -->
	<rule ref="SlevomatCodingStandard.Classes.ClassLength.ClassTooLong">
		<exclude-pattern>src/Client.php</exclude-pattern>
	</rule>
</ruleset>
