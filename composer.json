{
	"name": "ecomailcz/flexibee-client",
	"description": "ECOMAIL.CZ - Simple client for communication with FlexiBee API",
	"license": [
		"MIT"
	],
	"require": {
		"php": "^8.2",
		"ext-curl": "*",
		"ext-json": "*",
		"ext-mbstring": "*",
		"ext-simplexml": "*",
		"ecomailcz/purl": "^2.0",
		"rakit/validation": "^1.4"
	},
	"require-dev": {
		"brianium/paratest": "^6.10.0",
		"ergebnis/composer-normalize": "^2.34.0",
		"fakerphp/faker": "^1.24",
		"mockery/mockery": "^1.6.4",
		"pekral/ai-olympus": "^0.4",
		"pekral/phpcs-rules": "dev-master",
		"pekral/phpstan-rules": "dev-master",
		"pekral/rector-rules": "dev-master",
		"phpstan/extension-installer": "^1.3.1",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-deprecation-rules": "^2.0",
		"phpstan/phpstan-mockery": "^2.0",
		"phpstan/phpstan-phpunit": "^2.0",
		"phpunit/phpunit": "^9.6.10",
		"rector/rector": "^2.8"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"EcomailFlexibeeTest\\": [
				"tests/"
			],
			"EcomailFlexibee\\": [
				"src/"
			]
		}
	},
	"autoload-dev": {
		"classmap": [
			"tests/"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"ergebnis/composer-normalize": true,
			"pekral/ai-olympus": true,
			"phpstan/extension-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"ai-olympus:install": "vendor/bin/ai-olympus install --force",
		"analyse": "vendor/bin/phpstan analyse --memory-limit=2G --no-progress",
		"build": [
			"@fix",
			"@check"
		],
		"check": [
			"@composer-normalize-check",
			"@phpcs-check",
			"@rector-check",
			"@analyse",
			"@test"
		],
		"composer-normalize-check": "@composer normalize --dry-run",
		"fix": [
			"@composer normalize",
			"@rector-fix",
			"@phpcs-fix"
		],
		"phpcs-check": "vendor/bin/phpcs --standard=ruleset.xml src tests",
		"phpcs-fix": "vendor/bin/phpcbf --standard=ruleset.xml src tests || true",
		"rector-check": "vendor/bin/rector process --dry-run",
		"rector-fix": "vendor/bin/rector process",
		"security-audit": "@composer audit",
		"test": "vendor/bin/paratest --exclude-group=integration",
		"test:integration": "vendor/bin/paratest --group=integration"
	}
}
